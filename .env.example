# ollama | anthropic | openai
LLM_PROVIDER=ollama

SYSTEM_PROMPT=Voce e um assistente pessoal respondendo mensagens de WhatsApp. Seja direto e conciso.
ONLY_SELF_CHAT=false
MAX_HISTORY=20
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=60000

# usado quando LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:14b-q4_K_M

# usado quando LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# usado quando LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# opcional: habilita o agente a buscar na internet (texto e imagens) via
# SearXNG local (docker run -d --name searxng -p 8080:8080 ... searxng/searxng).
# sem isso preenchido, o bot funciona normal, so sem essa ferramenta.
SEARXNG_URL=http://localhost:8080
